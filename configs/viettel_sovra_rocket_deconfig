# Viettel SOVRA Rocket (CVA6) ZCU102 initial non-secure raw-QSPI profile.
CONFIG_RISCV=y
CONFIG_TARGET_VIETTEL_SOVRA_ROCKET=y
CONFIG_ARCH_RV64I=y
CONFIG_RISCV_SMODE=y
CONFIG_SYS_MALLOC_LEN=0x800000
CONFIG_NR_DRAM_BANKS=1
CONFIG_HAS_CUSTOM_SYS_INIT_SP_ADDR=y
CONFIG_CUSTOM_SYS_INIT_SP_ADDR=0x80200000
CONFIG_SYS_LOAD_ADDR=0x88000000
CONFIG_SYS_BOOTM_LEN=0x4000000
CONFIG_DEFAULT_DEVICE_TREE="viettel-sovra-rocket"
CONFIG_OF_SEPARATE=y
CONFIG_ENV_SIZE=0x20000
CONFIG_ENV_IS_NOWHERE=y
CONFIG_FIT=y
# CONFIG_FIT_SIGNATURE is not set
CONFIG_USE_BOOTCOMMAND=y
CONFIG_BOOTCOMMAND="run boot_qspi"
CONFIG_BOOTDELAY=3
CONFIG_CMD_BOOTI=y
CONFIG_CMD_BOOTMENU=y
CONFIG_CMD_FDT=y
CONFIG_CMD_ITEST=y
CONFIG_CMD_SETEXPR=y
CONFIG_HUSH_PARSER=y
CONFIG_DISPLAY_CPUINFO=y
CONFIG_DISPLAY_BOARDINFO=y
# CONFIG_NET is not set
# CONFIG_MMC is not set
# CONFIG_USB is not set
# CONFIG_SPI is not set
