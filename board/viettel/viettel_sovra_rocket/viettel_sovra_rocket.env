stdin=serial
stdout=serial
stderr=serial

bootdelay=1
menucmd=bootmenu -1
bootmenu_0=Boot from QSPI=run boot_qspi
bootmenu_1=Boot from eMMC=echo eMMC controller unavailable; false
bootmenu_2=U-boot console=echo U-Boot console

kernel_addr_r=0x81000000
fdt_addr_r=0x82000000
ramdisk_addr_r=0x84000000

qspi_dtb_addr=0xc0500000
qspi_kernel_addr=0xc0600000
qspi_rootfs_addr=0xc1a00000

boot_fail=echo [VIETTEL SOVRA BOOT] ERROR: ${boot_errmsg}; false
check_dtb=if fdt addr -q ${qspi_dtb_addr}; then true; else setenv boot_errmsg no_valid_dtb_at_${qspi_dtb_addr}; false; fi
check_kernel=setexpr kernel_magic_addr ${qspi_kernel_addr} + 0x38; if itest.l *${kernel_magic_addr} == 0x05435352; then true; else setenv boot_errmsg no_riscv_image_at_${qspi_kernel_addr}; false; fi
get_rootfs_size=if fdt addr -q ${qspi_dtb_addr} && fdt get value rootfs_start /chosen linux,initrd-start 1 && fdt get value rootfs_end /chosen linux,initrd-end 1; then setexpr rootfs_size ${rootfs_end} - ${rootfs_start}; else setenv boot_errmsg initrd_size_missing_in_source_dtb; false; fi
boot_qspi=setenv boot_errmsg; if run check_dtb && run check_kernel && run get_rootfs_size; then if fdt header get fdt_size totalsize && cp.b ${qspi_dtb_addr} ${fdt_addr_r} ${fdt_size} && setexpr kernel_size_addr ${qspi_kernel_addr} + 0x10 && setexpr.l kernel_size *${kernel_size_addr} && cp.b ${qspi_kernel_addr} ${kernel_addr_r} ${kernel_size} && cp.b ${qspi_rootfs_addr} ${ramdisk_addr_r} ${rootfs_size}; then booti ${kernel_addr_r} ${ramdisk_addr_r}:${rootfs_size} ${fdt_addr_r}; setenv boot_errmsg booti_returned; fi; fi; run boot_fail
